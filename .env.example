# Copy this file to .env (same folder as README.md) and fill in your values.
# The app reads .env automatically on start. .env is git-ignored, so your key stays private.
CP_BACKEND=local
CP_DUCKDB_PATH=data/campuspulse.duckdb
CP_LIVE_SIM=true
CP_INGEST_KEY=dev-ingest-key

# Gemini: either an AI Studio key...
GEMINI_API_KEY=AQ.Ab8RN6IJD9RUgWyxpjonmpRPc_hFmsR3cX6d073UGIFdi8yiUA
# ...or Vertex AI with your project
# CP_GEMINI_VERTEX=true
# GOOGLE_CLOUD_PROJECT=
CP_GEMINI_MODEL=gemini-3.5-flash-lite

# BigQuery backend
# CP_BACKEND=bigquery
# CP_BQ_DATASET=campuspulse
# CP_BQ_LOCATION=asia-southeast1
# CP_PUBSUB_TOPIC=projects/<project>/topics/campuspulse-telemetry

# Energy price used for savings estimates. Set from the current TNB commercial tariff.
CP_TARIFF_RM_PER_KWH=0.50
# Grid carbon factor for kg CO2e figures (Peninsular Malaysia).
CP_GRID_KG_CO2E_PER_KWH=0.758
CP_CO2_LIMIT_PPM=1000

# Device commands for approved AC changes. Unset: nodes pull them over HTTPS.
# CP_MQTT_HOST=192.168.1.10
# CP_MQTT_PORT=1883
# CP_MQTT_USER=
# CP_MQTT_PASS=
# CP_MQTT_TLS=false
